# Easiest: run `uv run jarvis setup` and answer four questions.
# Or copy this file to ~/.jarvis/.env and run `chmod 600 ~/.jarvis/.env`.

# Voice engine. Set at least one key; with both, Gemini is used because it's cheaper.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# JARVIS_VOICE_PROVIDER=gemini
# JARVIS_DEFAULT_LANGUAGE=English
# JARVIS_PROJECTS_ROOT=~/Projects
# JARVIS_GEMINI_VOICE=Enceladus
# JARVIS_GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
# JARVIS_VOICE=cinder

# Claude Code jobs: sonnet at low effort keeps spoken requests fast
# JARVIS_CLAUDE_MODEL=sonnet
# JARVIS_CLAUDE_EFFORT=low
# How much Claude does without asking: full (asks only before paying), balanced, careful (also any push or send).
# The panel and menu bar switch it live; that choice is saved and wins over this.
# JARVIS_AUTONOMY=balanced

# JARVIS_HOTKEY=<ctrl>+<alt>+j
# JARVIS_INPUT_DEVICE=auto
# JARVIS_WAKE_THRESHOLD=0.5
# JARVIS_IDLE_CLOSE_S=20
# JARVIS_AWAY_AFTER_S=600
# JARVIS_CONFIRM_TIMEOUT_S=120

# Optional: orders from your phone, and reports while you're away.
# Create a bot with @BotFather, press Start in it, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates (message.chat.id).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: real OpenAI spend in `jarvis report` (needs an organization Admin key)
# OPENAI_ADMIN_KEY=

# Rarely needed (set in your shell environment, not here):
# JARVIS_HOME=~/.jarvis        where settings, memory and logs live
# JARVIS_PANEL_PORT=8787
# JARVIS_PANEL_AUTOOPEN=1
