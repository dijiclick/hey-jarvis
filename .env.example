# Easiest: run `uv run jarvis setup` and answer three questions.
# Or copy this file to ~/.jarvis/.env and run `chmod 600 ~/.jarvis/.env`.

# Voice engine. Set at least one key; with both, Gemini is used because it's cheaper.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# JARVIS_VOICE_PROVIDER=gemini
# JARVIS_DEFAULT_LANGUAGE=English
# JARVIS_PROJECTS_ROOT=~/Projects
# JARVIS_GEMINI_VOICE=Enceladus
# JARVIS_VOICE=cinder
# JARVIS_HOTKEY=<ctrl>+<alt>+j
# JARVIS_INPUT_DEVICE=auto

# Optional: job reports on Telegram while you're away from the Mac
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: real OpenAI spend in `jarvis report` (needs an organization Admin key)
# OPENAI_ADMIN_KEY=
